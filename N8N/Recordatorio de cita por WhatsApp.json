    {
      "parameters": {
        "jsCode": "const whatsapp = $json.body?.whatsapp ?? {};\nconst client = $json.body?.client ?? {};\nconst event = String($json.body?.event ?? '');\n\nconst number = String(whatsapp.to ?? client.phone ?? '').replace(/\\D/g, '');\nconst text = String(whatsapp.message ?? whatsapp.text ?? '').trim();\nconst file = whatsapp.file ?? null;\n\nfunction mediaTypeFromMime(mimeType) {\n  const mime = String(mimeType ?? '').toLowerCase();\n  if (mime.startsWith('image/')) return 'image';\n  if (mime.startsWith('video/')) return 'video';\n  if (mime.startsWith('audio/')) return 'audio';\n  return 'document';\n}\n\nif (event === 'client.whatsapp.file.requested' || file?.data) {\n  if (!number || !file?.data || !file?.fileName) {\n    throw new Error('Faltan number o archivo para Evolution API');\n  }\n\n  return [{\n    json: {\n      ...$json,\n      evolutionUrl: 'https://evo.hiworkflow.mx/message/sendMedia/consultorioPrueba',\n      evolutionPayload: {\n        number,\n        mediatype: mediaTypeFromMime(file.mimeType),\n        mimetype: file.mimeType || 'application/octet-stream',\n        caption: String(whatsapp.caption ?? '').trim(),\n        media: file.data,\n        fileName: file.fileName\n      }\n    }\n  }];\n}\n\nif (!number || !text) {\n  throw new Error('Faltan number o text para Evolution API');\n}\n\nreturn [{\n  json: {\n    ...$json,\n    evolutionUrl: 'https://evo.hiworkflow.mx/message/sendText/consultorioPrueba',\n    evolutionPayload: {\n      number,\n      text\n    }\n  }\n}];"
      },
