        "jsCode": "const expectedSecret = 'CAMBIA_ESTE_SECRETO_POR_UNO_LARGO';\nconst receivedSecret = $json.headers?.['x-webhook-secret'] ?? '';\n\nreturn [\n  {\n    json: {\n      ...$json,\n      authorized: receivedSecret === expectedSecret,\n    },\n  },\n];"
