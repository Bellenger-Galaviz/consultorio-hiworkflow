# Base de datos
# Local: una sola URL basta y DIRECT_URL puede apuntar a la misma.
# Supabase: DATABASE_URL es la conexion pooled (puerto 6543, con ?pgbouncer=true)
# y DIRECT_URL la conexion directa (puerto 5432), que es la que usan las migraciones.
DATABASE_URL="postgresql://consultorio_user:CAMBIA_ESTA_PASSWORD@localhost:5432/consultorio_db?schema=public"
DIRECT_URL="postgresql://consultorio_user:CAMBIA_ESTA_PASSWORD@localhost:5432/consultorio_db?schema=public"

# Almacenamiento de archivos clinicos
# Sin estas variables se usa el disco local (storage/client-files).
# Con ellas se usa Supabase Storage, necesario en Vercel porque su filesystem es efimero.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="client-files"

# WhatsApp (opcional: la app arranca sin esto)
N8N_REMINDER_WEBHOOK_URL="https://n8n.hiworkflow.mx/webhook/recordatorio-cita"
N8N_WEBHOOK_SECRET="cambia-este-secreto"

APP_PUBLIC_URL="http://localhost:3000"
